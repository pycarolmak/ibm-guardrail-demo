# HuggingFace API Key
HF_API_KEY=your_huggingface_api_key_here

# IBM Cloud API Key for Guardrails
IBM_API_KEY=your_ibm_cloud_api_key_here

# Guardrails API Base URL
GUARDRAILS_API_URL=https://api.aiopenscale.cloud.ibm.com

# Common Configuration
INVENTORY_ID=your_inventory_id_here
GOVERNANCE_INSTANCE_ID=your_governance_instance_id_here

# =============================================================================
# INDIVIDUAL DETECTOR POLICIES
# Each policy is configured for a single detector to enable individual testing
# =============================================================================

# --- INPUT DETECTORS ---

# PII Detection Policy
POLICY_ID_PII=your_pii_policy_id_here

# Harm Detection Policy
POLICY_ID_HARM=your_harm_policy_id_here

# Jailbreak Detection Policy
POLICY_ID_JAILBREAK=your_jailbreak_policy_id_here

# Social Bias Detection Policy
POLICY_ID_SOCIAL_BIAS=your_social_bias_policy_id_here

# Profanity Detection Policy
POLICY_ID_PROFANITY=your_profanity_policy_id_here

# Sexual Content Detection Policy
POLICY_ID_SEXUAL_CONTENT=your_sexual_content_policy_id_here

# Unethical Behavior Detection Policy
POLICY_ID_UNETHICAL_BEHAVIOR=your_unethical_behavior_policy_id_here

# Violence Detection Policy
POLICY_ID_VIOLENCE=your_violence_policy_id_here

# HAP (Hate, Abuse, Profanity) Detection Policy
POLICY_ID_HAP=your_hap_policy_id_here

# Topic Relevance Detection Policy (requires system_prompt parameter)
POLICY_ID_TOPIC_RELEVANCE=your_topic_relevance_policy_id_here

# Prompt Safety Risk Detection Policy (requires system_prompt parameter)
POLICY_ID_PROMPT_SAFETY_RISK=your_prompt_safety_risk_policy_id_here

# Keyword Detection Policy
POLICY_ID_KEYWORD=your_keyword_policy_id_here

# Regular Expression Detection Policy
POLICY_ID_REGULAR_EXPRESSION=your_regular_expression_policy_id_here

# --- OUTPUT DETECTORS (additional) ---

# Groundedness Detection Policy (requires context parameter)
POLICY_ID_GROUNDEDNESS=your_groundedness_policy_id_here

# Context Relevance Detection Policy (requires context parameter)
POLICY_ID_CONTEXT_RELEVANCE=your_context_relevance_policy_id_here

# Answer Relevance Detection Policy (requires prompt parameter)
POLICY_ID_ANSWER_RELEVANCE=your_answer_relevance_policy_id_here

# =============================================================================
# LEGACY: Combined Policy (fallback - may cause validation errors)
# =============================================================================
POLICY_ID=your_legacy_policy_id_here